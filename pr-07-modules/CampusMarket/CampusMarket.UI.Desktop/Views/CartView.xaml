<Window x:Class="CampusMarket.UI.Desktop.Views.CartView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина" Height="320" Width="420">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding CartLines}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Итого, руб.: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CartTotal, StringFormat=F2}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Оформить заказ" Command="{Binding CheckoutCommand}" Padding="10,4"/>
        </StackPanel>
    </Grid>
</Window>
